<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Out-of-process measurements with the same method for the port and the original
    (docs/performance.md): time to the main window and to the loaded text, and the Edit control
    load experiment. Not part of the test run.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NotepadClassic.PerfHarness</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
