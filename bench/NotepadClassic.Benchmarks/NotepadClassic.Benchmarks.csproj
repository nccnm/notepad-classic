<Project Sdk="Microsoft.NET.Sdk">
  <!-- BenchmarkDotNet, in-process, over the hot paths of Core with the real Win32 services. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NotepadClassic.Benchmarks</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NotepadClassic.Core\NotepadClassic.Core.csproj" />
    <ProjectReference Include="..\..\src\NotepadClassic.Platform\NotepadClassic.Platform.csproj" />
  </ItemGroup>
</Project>
