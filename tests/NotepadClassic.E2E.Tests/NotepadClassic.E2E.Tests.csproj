<Project Sdk="Microsoft.NET.Sdk">
  <!--
    End-to-end tests: FlaUI (UIA3) drives the built NotepadClassicPort.exe as a user would, with a
    temporary settings hive and autosave folder (environment variables) and files in a temporary
    folder. Every wait is on a condition, never a fixed sleep.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NotepadClassic.E2E.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built first; the tests start the exe from its output folder. -->
    <ProjectReference Include="..\..\src\NotepadClassic.App\NotepadClassic.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>
</Project>
